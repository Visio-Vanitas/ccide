{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Read|Edit|Update|FileEdit|StrReplace|MultiEdit|Write|NotebookEdit|LSP|Grep|Glob|TaskCreate|TaskUpdate|TodoWrite",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/scripts/ensure-ccide-core.sh\" yazi-hook",
            "timeout": 15
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/scripts/ensure-ccide-core.sh\" yazi-hook",
            "timeout": 15
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/scripts/ensure-ccide-core.sh\" yazi-hook",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
