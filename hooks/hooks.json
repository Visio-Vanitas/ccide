{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Read|Edit|Update|FileEdit|StrReplace|MultiEdit|Write|NotebookEdit|LSP|Grep|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/ensure-ccide-core.mjs\" yazi-hook",
            "timeout": 15
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/ensure-ccide-core.mjs\" yazi-hook",
            "timeout": 15
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/ensure-ccide-core.mjs\" yazi-hook",
            "timeout": 15
          }
        ]
      }
    ],
    "PostModelSwitch": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/ensure-ccide-core.mjs\" yazi-hook",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/ensure-ccide-core.mjs\" yazi-hook",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
