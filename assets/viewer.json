{
  // Viewer layout, line-wrapping & sprite configuration (`~/.config/cc-ide/viewer.json`).
  // - "wrap": false (default) renders diffs, commit graphs, and Markdown previews in full
  //   without line breaks; pan horizontally via Magic Mouse or keyboard (H/L, Shift/Alt + Left/Right).
  // - "wrap": true wraps long lines right up to the panel border with vi-style `↪` / `↩` markers.
  // - "sprite_mode": "auto" (uses PNG/JPG sprites on iTerm2/WezTerm/Kitty/Ghostty, `.ansi` art elsewhere),
  //   "ascii" (always standalone `.ansi` character art), or "image" (force inline image protocol).
  "wrap": false,
  "wrap_style": "vi",
  "sprite_mode": "auto"
}
